  "process": {
    "label": "Proceso",
    "title": "Del brief al arte final.",
    "steps": [
      { "name": "Brief", "body": "Escuchar primero: qué se quiere decir, a quién y con qué recursos." },
      { "name": "Investigación", "body": "Referencias, competencia y contexto. Un moodboard con criterio, no una pila de imágenes." },
      { "name": "Bocetos", "body": "Muchas ideas en papel antes de abrir la computadora. Se eligen dos o tres para desarrollar." },
      { "name": "Sistema", "body": "La idea se vuelve reglas: color, tipografía, retícula y cómo se aplica en cada pieza." },
      { "name": "Arte final", "body": "Archivos revisados para imprenta o pantalla: CMYK, 300 dpi, sangrado y fuentes incluidas." }
    ]
  },
