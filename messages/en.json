  "story": {
    "label": "Story",
    "title": "Six sheets.",
    "lead": "A story told the way a printed piece is built: layer by layer, until everything is in register.",
    "progress": "Sheet",
    "chapters": [
      {
        "title": "The kitchen table",
        "body": "Old magazines, scissors and glue. Before she knew what design was, Abigail was already making collages: one image on top of another until something new appeared.",
        "tool": "Collage"
      },
      {
        "title": "Layers",
        "body": "Her first computer came with Photoshop, and with it an idea she never let go of: every image is a stack of decisions. Any step can be undone. The eye can't.",
        "tool": "Photoshop"
      },
      {
        "title": "Vectors",
        "body": "Illustrator taught her patience: a Bézier curve is tuned one anchor at a time. That is where her first brands were born, and her obsession with type.",
        "tool": "Illustrator"
      },
      {
        "title": "Grid",
        "body": "InDesign taught her the rhythm of a page: columns, margins and air. A well-set magazine reads without anyone noticing the grid.",
        "tool": "InDesign"
      },
      {
        "title": "Motion",
        "body": "After Effects and Premiere gave design a sense of time. A logo that arrives on the beat says more than one that just sits there.",
        "tool": "After Effects · Premiere Pro"
      },
      {
        "title": "Today",
        "body": "She designs whole systems: from a brand to its campaign, from the sketch to a PDF that reaches the printer without a single error. The full Adobe suite in the service of one clear idea.",
        "tool": "Creative Cloud"
      }
    ]
  },
