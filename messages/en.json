  "process": {
    "label": "Process",
    "title": "From brief to final art.",
    "steps": [
      { "name": "Brief", "body": "Listen first: what needs saying, to whom and with what resources." },
      { "name": "Research", "body": "References, competitors and context. A moodboard with judgement, not a pile of images." },
      { "name": "Sketches", "body": "Plenty of ideas on paper before opening the computer. Two or three are chosen to develop." },
      { "name": "System", "body": "The idea becomes rules: colour, type, grid and how it applies to every piece." },
      { "name": "Final art", "body": "Files checked for print or screen: CMYK, 300 dpi, bleed and fonts included." }
    ]
  },
